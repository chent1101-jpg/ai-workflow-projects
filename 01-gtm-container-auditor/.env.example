# OpenRouter key — one key reaches open-weight and frontier models.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model routing. Aliases resolve to live OpenRouter slugs at runtime
# (see _shared/llm.py ALIASES): deepseek | glm | kimi | haiku | sonnet | opus.
#
# FAST handles the two near-classification tasks (naming coherence, impact
# ranking). DEEP handles the two that require reasoning about consequence
# (custom HTML risk, PII exposure). evals/ measures whether that split holds.
JUDGE_MODEL_FAST=deepseek
JUDGE_MODEL_DEEP=sonnet
