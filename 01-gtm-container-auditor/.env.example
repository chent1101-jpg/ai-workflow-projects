# Anthropic API key for the LLM judgment layer (src/judge.py).
# Deterministic rules (src/rules.py) run without any key.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Model routing. Cheap model for classification, expensive for risk reasoning.
JUDGE_MODEL_FAST=claude-haiku-4-5-20251001
JUDGE_MODEL_DEEP=claude-sonnet-5

# Hard ceiling per audit run; the judge aborts rather than exceeding it.
MAX_TOKENS_PER_RUN=120000
